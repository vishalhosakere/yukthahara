# Development only (.env.development): opens the local-mode CMS at /keystatic on your machine.
KEYSTATIC_LOCAL_ADMIN=true

# ---- Production CMS: set ONE of the two options in Netlify > Site configuration > Environment variables ----

# Option A, GitHub mode: editors sign in with GitHub; only collaborators on the repo can save.
# Keystatic creates the GitHub App on the first visit to /keystatic and shows the values to copy here.
NEXT_PUBLIC_KEYSTATIC_STORAGE=github
NEXT_PUBLIC_KEYSTATIC_REPO=vishalhosakere/yukthahara
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Option B, Keystatic Cloud: the owner signs in with an email invite, no GitHub account needed.
# Create a project at https://keystatic.cloud, connect this repo, then:
# NEXT_PUBLIC_KEYSTATIC_STORAGE=cloud
# NEXT_PUBLIC_KEYSTATIC_CLOUD_PROJECT=your-team/yuktaahara

# ---- Search ----
# Google Search Console "HTML tag" verification: paste only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
